{
  "name": "cdktn-playwright-screenshot",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "cdktn": "cdktn",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "deploy": "pnpm bundle && cdktn deploy --auto-approve",
    "destroy": "cdktn destroy --auto-approve",
    "dev": "wrangler dev",
    "diff": "pnpm bundle && cdktn diff",
    "format": "biome format --write .",
    "gen": "cdktn get",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "pnpm bundle",
    "pretest:watch": "pnpm bundle",
    "synth": "pnpm bundle && cdktn synth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/playwright": "catalog:",
    "cdktn": "catalog:",
    "constructs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "cdktn-cli": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
