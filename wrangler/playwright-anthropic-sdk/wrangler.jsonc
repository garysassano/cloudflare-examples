{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anthropic-sdk-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["new_module_registry"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },
  "browser": { "binding": "BROWSER" },
  "secrets": { "required": ["ANTHROPIC_API_KEY"] }
}
